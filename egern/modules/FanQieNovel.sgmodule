#!name=番茄小说（原版修正 v6）
#!desc=番茄小说广告屏蔽（zqzess v3.1 原版，仅删除 dig.bdurl.net 一条：拦它会影响听书功能/进度保存，见原仓库 issue #66；其余内容与原版完全一致；v2 再撤三处会误伤听书播放的项，见文件内 [v2删除] 标注）
#!category=zqzess
# 修正版说明（2026-10-30，BitJarvis/firewall）：基于 zqzess/rule_for_quantumultX 的 Surge/Module/FanQieNovel.sgmodule 原文。
# v1 改动：注释 dig.bdurl.net（坏听书进度，issue #66）。
# v2 改动（用户实测原版与 v1 都会让听书下一章不播放）：撤掉三类正文媒体相关项——
#   ① ixigua 的 novelapp 内容域两条；② fqnovelvod/snssdk 的 video 播放路径重写两条；
#   ③ DOMAIN-KEYWORD,zijieapi 整段封锁，换成精确广告子域（与 egern/rules/fanqie-ads.yaml 同口径）。
# 其余规则/重写/MITM 与原版一致。
# v4 改动（播放优先）：放行配置下发/监控上报/安全指纹类域名与全部 IP 条目，只保留广告下发链路，逐条见 [v4放行] 标注。
# v3 改动（2026-10-30，用户关模块抓日志实证）：再删 is.snssdk.com 与 ma.zijieapi.com——
#   两者都在正常听书的请求里出现（is.snssdk.com 单次回了 148KB 数据），不是纯广告域。

[Rule]
# 番茄小说 version = 3.1
DOMAIN,p6-ad-sign.byteimg.com,REJECT
DOMAIN,p9-ad-sign.byteimg.com,REJECT
# DOMAIN-SUFFIX,byteimg.com,DIRECT
# [v5放行] DOMAIN,i.snssdk.com,REJECT —— snssdk 通用内容/API 网关，播放器依赖，见文件头
# [v5放行] DOMAIN,i-lq.snssdk.com,REJECT —— snssdk 通用内容/API 网关，播放器依赖，见文件头
# [修正版删除] DOMAIN,dig.bdurl.net,REJECT —— 拦它会让听书进度保存不了（zqzess issue #66），故注释掉
# [v2删除] DOMAIN,imapi3-normal-lf.zijieapi.com,DIRECT —— 那是给整段封 zijieapi 打的补丁，现已不需要
# [v2替换] 原版 DOMAIN-KEYWORD,zijieapi,REJECT 整段封锁会误伤正文接口，换成精确广告子域：
DOMAIN,ads3-normal.zijieapi.com,REJECT
DOMAIN,ads5-normal.zijieapi.com,REJECT
DOMAIN,minigame3-normal.zijieapi.com,REJECT
DOMAIN,minigame5-normal.zijieapi.com,REJECT
# [v4放行] DOMAIN,gecko3.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,gecko5.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,mssdk.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,timon.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,vcs.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
# [v3删除] DOMAIN,ma.zijieapi.com,REJECT —— 出现在用户听书请求清单里，先放行保播放
# [v4放行] DOMAIN,feedback-c.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,abtest3-misc.zijieapi.com,REJECT —— 配置/监控/安全类，非广告下发
DOMAIN,ads*-normal-*.zijieapi.com,REJECT
DOMAIN,minigame*-normal-*.zijieapi.com,REJECT
# [v4放行] DOMAIN,gecko*.zijieapi.com,REJECT —— 配置下发类（gecko/日志/监控）
# DOMAIN,ads3-normal-lq.zijieapi.com,REJECT
# DOMAIN,ads5-normal-lq.zijieapi.com,REJECT
# DOMAIN,polaris3-normal-lq.zijieapi.com,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT

# [v4放行] DOMAIN,mcs.snssdk.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,tnc3-alisc1.snssdk.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,security-lq.snssdk.com,REJECT —— 配置/监控/安全类，非广告下发
# [v4放行] DOMAIN,tnc3-aliec2.snssdk.com,REJECT —— 配置/监控/安全类，非广告下发
# [v3删除] DOMAIN,is.snssdk.com,REJECT —— 正常听书时它回了 148KB 数据，疑似播放/章节数据通道

# [v4放行] DOMAIN,msync-im1-vip6-std.easemob.com,REJECT —— 配置/监控/安全类，非广告下发

DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net,REJECT
DOMAIN,api.iegadp.qq.com,REJECT

DOMAIN,sf3-ttcdn-tos.pstatp.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
# DOMAIN,p3-be-pack-sign.pglstatp-toutiao.com,REJECT
# DOMAIN,sf3-be-pack.pglstatp-toutiao.com,REJECT

DOMAIN,*default.ixigua.com,REJECT
# [v2删除] DOMAIN,v6-novelapp.ixigua.com,REJECT —— novelapp 是正文音频/视频内容域，拦了听书下一章不播放
# [v2删除] DOMAIN,*novelapp.ixigua.com,REJECT —— 同上
# DOMAIN,v3-default.ixigua.com,REJECT
# DOMAIN,v9-default.ixigua.com,REJECT
# DOMAIN,v6-default.ixigua.com,REJECT

# [v4放行] DOMAIN-SUFFIX,byteorge.com,REJECT —— 整段后缀过宽，非广告下发
# [v4放行] DOMAIN-SUFFIX,bytegoofy.com,REJECT —— 整段后缀过宽，非广告下发
# [v4放行] DOMAIN-SUFFIX,bytedance.com,REJECT —— 整段后缀过宽，非广告下发

# [v4放行] IP-CIDR,49.71.37.101/32,REJECT,no-resolve —— 经查为 abtest/mssdk/tnc 配置节点 IP，非广告
# [v4放行] IP-CIDR,117.71.105.23/32,REJECT,no-resolve —— 经查为 abtest/mssdk/tnc 配置节点 IP，非广告
# [v4放行] IP-CIDR,218.94.207.205/32,REJECT,no-resolve —— 经查为 abtest/mssdk/tnc 配置节点 IP，非广告
# [v4放行] IP-CIDR,117.92.229.188/32,REJECT,no-resolve —— 经查为 abtest/mssdk/tnc 配置节点 IP，非广告
# [v4放行] IP-CIDR,101.36.166.16/32,REJECT,no-resolve —— 经查为 abtest/mssdk/tnc 配置节点 IP，非广告
# [v4放行] IP-CIDR,180.96.2.114/32,REJECT,no-resolve —— 经查为 abtest/mssdk/tnc 配置节点 IP，非广告

URL-REGEX,*-default.ixigua.com,REJECT
# URL-REGEX,.+web\.business\.image,REJECT
URL-REGEX,^http:\/\/.+\.byteimg\.com\/ad-app-package,REJECT
URL-REGEX,^http:\/\/.+\.byteimg\.com\/web\.business\.image,REJECT
# 番茄视频广告页的sdk agent都是ttplayer
# USER-AGENT,ttplayer*,REJECT

[URL Rewrite]
# 番茄小说去章末广告
^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(get_ads|stats|settings)\/ - reject
^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4 - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/(ad-app-package|ad)\/.+ - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/web\.business\.image\/.+ - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer - reject
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package - reject
^https?:\/\/.+\.byteimg.com/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg - reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad - reject
^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.+ - reject
# [v2删除] snssdk 的 video/play 播放接口重写 —— ttplayer 播正文音频也走播放接口，拦了下一章不播放
^https?:\/\/.+\.snssdk.com\/api\/ad\/.+ - reject
# 下面两条来自他人,暂不知是哪个app
^https?:\/\/.+?\.snssdk\.com\/motor\/operation\/activity\/display\/config\/V2\/ - reject

^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(ad-app-package|ad)\/.+ - reject
^https?:\/\/adim\.pinduoduo\.com\/.+\/toutiao\?.+ - reject
# [v2删除] fqnovelvod 的 novelapp/video 路径重写 —— 那是正文媒体 CDN 路径，同上

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao,*.pangolin-sdk-toutiao.*,*.pstatp.com,*.pstatp.com.*,*.pglstatp-toutiao.com.*,*.pglstatp-toutiao.com,gurd.snssdk.com,gurd.snssdk.com.*,*default.ixigua.com,adim.pinduoduo.com
# [v6删除] MITM 名单去掉 *.fqnovelvod.com——v2 已删该域的全部重写，解密只剩副作用：
#   原版与修正版都不能播、dig 规则两版不同却同样失败，排除 dig；两版共同项里只有 MITM 解密 fqnovelvod 能碰到音频流（ttplayer/VOD 对解密敏感）。
#   且用户 09:00 关模块日志里 dig 照样 REJECT 但播放正常，证明 dig 只管进度同步、不是播放元凶。
